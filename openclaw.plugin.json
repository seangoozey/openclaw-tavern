{
  "id": "texting-sim",
  "name": "OpenClaw Texting Simulator Plugin",
  "description": "Persistent character texting simulator for OpenClaw with card import, owned generation, memory, schedule-aware state, proactive outreach, and multimodal tools.",
  "version": "0.4.2",
  "author": "seangoozey",
  "homepage": "https://github.com/seangoozey/openclaw-tavern",
  "license": "MIT",
  "tags": [
    "roleplay",
    "texting-simulator",
    "character-cards",
    "companion",
    "tts",
    "image-generation",
    "long-memory"
  ],
  "contracts": {
    "tools": [
      "rp_generate_image"
    ]
  },
  "toolMetadata": {
    "rp_generate_image": {
      "optional": true
    }
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "agentImage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "provider": {
            "type": "string",
            "enum": [
              "inherit",
              "openai",
              "gemini"
            ],
            "default": "inherit"
          },
          "imageModel": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allowedAgents": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "default": []
      },
      "telegram": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "botToken": {
            "type": "string",
            "minLength": 1
          },
          "apiBaseUrl": {
            "type": "string",
            "minLength": 1,
            "default": "https://api.telegram.org"
          }
        }
      },
      "provider": {
        "type": "string",
        "enum": [
          "inherit",
          "openai",
          "gemini"
        ],
        "default": "inherit"
      },
      "openai": {
        "type": "object",
        "additionalProperties": true
      },
      "gemini": {
        "type": "object",
        "additionalProperties": true
      },
      "nativeHooks": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "replyPayloadSending": {
            "type": "boolean",
            "default": false
          },
          "inboundClaim": {
            "type": "boolean",
            "default": false
          },
          "beforeAgentReply": {
            "type": "boolean",
            "default": false
          },
          "beforeAgentRun": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "agentHarness": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "diagnostics": {
            "type": "boolean",
            "default": false
          },
          "runAttemptDiagnostics": {
            "type": "boolean",
            "default": false
          },
          "ownedGeneration": {
            "type": "boolean",
            "default": false
          },
          "runAttemptProvider": {
            "type": "string",
            "minLength": 1
          },
          "runAttemptModel": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
