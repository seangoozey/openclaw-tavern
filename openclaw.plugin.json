{
  "id": "openclaw-rp-plugin",
  "name": "OpenClaw SillyTavern Plugin",
  "description": "SillyTavern-compatible role-play command plugin for OpenClaw with long memory, multimodal output, and Generative-Agents-style companion.",
  "version": "0.3.0",
  "author": "garfeildma",
  "homepage": "https://github.com/garfeildma/openclaw-tavern",
  "license": "MIT",
  "tags": [
    "roleplay",
    "sillytavern",
    "companion",
    "tts",
    "image-generation",
    "long-memory"
  ],
  "clawhub": {
    "slug": "openclaw-tavern-plugin",
    "category": "roleplay"
  },
  "contracts": {
    "tools": [
      "rp_generate_image"
    ]
  },
  "toolMetadata": {
    "rp_generate_image": {
      "optional": true
    }
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "agentImage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "provider": {
            "type": "string",
            "enum": [
              "inherit",
              "openai",
              "gemini"
            ],
            "default": "inherit"
          },
          "imageModel": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allowedAgents": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "default": []
      },
      "telegram": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "botToken": {
            "type": "string",
            "minLength": 1
          },
          "apiBaseUrl": {
            "type": "string",
            "minLength": 1,
            "default": "https://api.telegram.org"
          }
        }
      },
      "nativeHooks": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "replyPayloadSending": {
            "type": "boolean",
            "default": false
          },
          "inboundClaim": {
            "type": "boolean",
            "default": false
          },
          "beforeAgentReply": {
            "type": "boolean",
            "default": false
          },
          "beforeAgentRun": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  }
}
