{
  "name": "texting-sim",
  "version": "0.4.1",
  "description": "Persistent character texting simulator for OpenClaw with card import, owned generation, memory, schedule-aware state, proactive outreach, and multimodal tools.",
  "author": "seangoozey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/seangoozey/openclaw-tavern.git"
  },
  "keywords": ["openclaw", "texting-simulator", "roleplay", "character-cards", "companion", "tts", "image-generation", "long-memory"],
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./providers/openaiCompatible": "./src/providers/openaiCompatible.js",
    "./providers/attachmentResolvers": "./src/providers/attachmentResolvers.js",
    "./channels/adapters": "./src/channels/adapters.js",
    "./openclaw/register": "./src/openclaw/register.js"
  },
  "openclaw": {
    "extensions": ["./src/openclaw/register.js"]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "openclaw": "*",
    "better-sqlite3": "^9.0.0",
    "js-tiktoken": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "openclaw": {
      "optional": true
    },
    "js-tiktoken": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test",
    "smoke": "node examples/smoke-run.js",
    "card:update": "node scripts/update-card-png.js",
    "card:update-png": "node scripts/update-card-png.js"
  }
}
